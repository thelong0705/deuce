# Copy to .env and fill in the Stripe keys from the dashboard, test mode.
# .env is gitignored; this file is the reference for what the stack needs.

DB_URL=postgres://deuce:deuce@localhost:5432/deuce?sslmode=disable
REDIS_ADDR=localhost:6379
CORS_ORIGINS=http://localhost:5173

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Optional. Defaults if unset: HTTP_ADDR=:8080, SWEEP_INTERVAL=1m
